    "+def _git_path_states(root: Path, paths: Iterable[str]) -> dict[str, Any]:",
    "+    \"\"\"Capture working bytes AND index entries; status names alone cannot prove ownership.\"\"\"",
    "+    result = subprocess.run([\"git\", \"ls-files\", \"--stage\", \"-z\"], cwd=root,",
    "+                            check=True, capture_output=True)",
    "+    stages: dict[str, list[str]] = {}",
    "+    for entry in result.stdout.decode(\"utf-8\", \"strict\").split(\"\\x00\"):",
    "+        if not entry:",
    "+            continue",
    "+        stage, name = entry.split(\"\\t\", 1)",
    "+        stages.setdefault(name, []).append(stage)",
    "+    states: dict[str, Any] = {}",
    "+    for name in sorted(set(paths)):",
    "+        relative = Path(name)",
    "+        if relative.is_absolute() or \"..\" in relative.parts:",
    "+            raise GovernanceError(f\"invalid Git path in worktree baseline: {name}\")",
    "+        path = root / relative",
    "+        if path.is_symlink():",
    "+            worktree = {\"kind\": \"symlink\", \"target\": os.readlink(path)}",
    "+        elif path.is_file():",
    "+            worktree = {\"kind\": \"file\", \"sha256\": hashlib.sha256(path.read_bytes()).hexdigest(),",
    "+                        \"mode\": path.stat().st_mode & 0o777}",
    "+        elif path.exists():",
    "+            raise GovernanceError(f\"unsupported dirty Git path: {name}\")",
    "+        else:",
    "+            worktree = {\"kind\": \"absent\"}",
    "+        states[name] = {\"worktree\": worktree, \"index\": sorted(stages.get(name, []))}",
    "+    return states",
    "+",
