    "lines": [
      {
        "line": 120,
        "text": "    for item in records:"
      },
      {
        "line": 121,
        "text": "        if outcome.get(\"status\") != \"Implemented\":"
      },
      {
        "line": 122,
        "text": "            raise GovernanceError(\"offer adversarial review only after an Implemented engineering result is saved\")"
      },
      {
        "line": 123,
        "text": "        stamp = _instant(item[\"recorded_at\"])"
      },
      {
        "line": 124,
        "text": "        if previous is not None and stamp < previous:"
      },
      {
        "line": 125,
        "text": "            raise GovernanceError(\"adversarial review records must follow engineering completion and prior records\")"
      },
      {
        "line": 126,
        "text": "        kind = item[\"event\"]"
      },
      {
        "line": 127,
        "text": "        if kind == \"Offer\":"
      },
      {
        "line": 128,
        "text": "            if accepted and not session_closed and status != \"Passed\" and recorded_streak != 2:"
      },
      {
        "line": 129,
        "text": "                raise GovernanceError(\"an active review must be completed or stopped before offering it again\")"
      },
      {
        "line": 130,
        "text": "            offered, accepted, streak, status = True, False, 0, \"AwaitingUser\""
      },
      {
        "line": 131,
        "text": "            legacy_streak = recorded_streak = 0"
      },
      {
        "line": 132,
        "text": "        elif kind == \"Decision\":"
      },
      {
        "line": 133,
        "text": "            if not offered:"
      },
      {
        "line": 134,
        "text": "                raise GovernanceError(\"record the actual post-completion question before a user decision\")"
      },
      {
        "line": 135,
        "text": "            if item[\"outcome\"] == \"Stopped\" and not accepted:"
      },
      {
        "line": 136,
        "text": "                raise GovernanceError(\"only an opted-in review can be stopped\")"
      },
      {
        "line": 137,
        "text": "            if accepted and not session_closed and status not in {\"Passed\", \"LegacyNotRevalidated\"} and recorded_streak != 2 and item[\"outcome\"] != \"Stopped\":"
      },
      {
        "line": 138,
        "text": "                raise GovernanceError(\"an active review only accepts an explicit stop decision\")"
      },
      {
        "line": 139,
        "text": "            accepted = item[\"outcome\"] == \"Accepted\""
      },
      {
        "line": 140,
        "text": "            if accepted:"
      },
      {
        "line": 141,
        "text": "                session_closed = False"
      },
      {
        "line": 142,
        "text": "            status = \"InProgress\" if accepted else item[\"outcome\"]"
      },
      {
        "line": 143,
        "text": "            streak = legacy_streak = recorded_streak = 0"
      }
    ]
  },
  {
    "path": "skills/product-engineering/run-governed-product-workflow/scripts/adversarial_review.py",
    "start": 357,
