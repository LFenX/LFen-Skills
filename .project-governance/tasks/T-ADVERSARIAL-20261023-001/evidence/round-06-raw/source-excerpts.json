      {
        "line": 22,
        "text": "def review_schema() -> dict[str, Any]:"
      },
      {
        "line": 23,
        "text": "    \"\"\"One schema definition, embedded into both existing outcome schemas.\"\"\""
      },
      {
        "line": 24,
        "text": "    text = {\"type\": \"string\", \"minLength\": 1}"
      },
      {
        "line": 25,
        "text": "    refs = {\"type\": \"array\", \"minItems\": 1, \"uniqueItems\": True, \"items\": text}"
      },
      {
        "line": 26,
        "text": "    strings = {\"type\": \"array\", \"uniqueItems\": True, \"items\": text}"
      },
      {
        "line": 27,
        "text": "    digest = {\"type\": \"string\", \"pattern\": \"^[0-9a-f]{64}$\"}"
      },
      {
        "line": 28,
        "text": ""
      },
      {
        "line": 29,
        "text": "    def obj(properties: dict[str, Any], optional: tuple[str, ...] = ()) -> dict[str, Any]:"
      },
      {
        "line": 30,
        "text": "        return {\"type\": \"object\", \"additionalProperties\": False,"
      },
      {
        "line": 31,
        "text": "                \"required\": [key for key in properties if key not in optional], \"properties\": properties}"
      },
      {
        "line": 32,
        "text": ""
      },
      {
        "line": 33,
        "text": "    variants = []"
      },
      {
        "line": 34,
        "text": "    details = {"
      },
      {
        "line": 35,
        "text": "        \"Offer\": {\"prompt\": text, \"evidence_ref\": text},"
      },
      {
        "line": 36,
        "text": "        \"Decision\": {\"outcome\": {\"enum\": [\"Accepted\", \"Declined\", \"Deferred\", \"Stopped\"]},"
      },
      {
        "line": 37,
        "text": "                     \"response\": text, \"decided_by\": text, \"evidence_ref\": text},"
      },
      {
        "line": 38,
        "text": "        \"Blocked\": {\"reason\": text, \"evidence_refs\": refs},"
      },
      {
        "line": 39,
        "text": "        \"Round\": {\"round_id\": text, \"started_at\": {\"type\": \"string\", \"format\": \"date-time\"},"
      },
      {
        "line": 40,
        "text": "                  \"reviewer\": text, \"delivery_task_id\": text, \"subject_sha256\": digest,"
      },
      {
        "line": 41,
        "text": "                  \"requirements_sha256\": digest, \"coverage\": {\"enum\": [\"Complete\", \"Incomplete\"]},"
      },
      {
        "line": 42,
        "text": "                  \"review_contract_version\": {\"const\": REVIEW_CONTRACT},"
      },
      {
        "line": 43,
        "text": "                  \"report_ref\": text, \"report_sha256\": digest,"
      },
      {
        "line": 44,
        "text": "                  \"delivery_completed_at\": {\"type\": \"string\", \"format\": \"date-time\"},"
      },
      {
        "line": 45,
        "text": "                  \"delivery_verified_at\": {\"type\": \"string\", \"format\": \"date-time\"},"
      },
      {
        "line": 46,
        "text": "                  \"session_completed\": {\"type\": \"boolean\"},"
      },
      {
        "line": 47,
        "text": "                  \"unreviewed_items\": strings, \"evidence_refs\": refs,"
      },
      {
        "line": 48,
        "text": "                  \"findings\": {\"type\": \"array\", \"items\": obj({\"id\": text, \"summary\": text,"
      },
      {
        "line": 49,
        "text": "                                                              \"evidence_refs\": refs})},"
      },
      {
        "line": 50,
        "text": "                  \"resolutions\": {\"type\": \"array\", \"items\": obj({\"finding_id\": text,"
      },
      {
        "line": 51,
        "text": "                     \"disposition\": {\"enum\": [\"Fixed\", \"NotAnIssue\"]}, \"reason\": text, \"evidence_refs\": refs})}},"
      },
      {
        "line": 52,
        "text": "    }"
      },
      {
        "line": 53,
        "text": "    for kind, properties in details.items():"
      },
      {
        "line": 54,
        "text": "        variants.append(obj({\"event\": {\"const\": kind},"
      },
      {
        "line": 55,
        "text": "                             \"recorded_at\": {\"type\": \"string\", \"format\": \"date-time\"}, **properties},"
      },
      {
        "line": 56,
        "text": "                            (\"review_contract_version\", \"report_ref\", \"report_sha256\", \"delivery_completed_at\", \"delivery_verified_at\", \"session_completed\") if kind == \"Round\" else ()))"
      },
      {
        "line": 57,
        "text": "    return {\"type\": \"array\", \"items\": {\"oneOf\": variants}}"
      },
      {
        "line": 58,
        "text": ""
      }
    ]
  },
  {
    "path": "skills/product-engineering/run-governed-product-workflow/scripts/adversarial_review.py",
