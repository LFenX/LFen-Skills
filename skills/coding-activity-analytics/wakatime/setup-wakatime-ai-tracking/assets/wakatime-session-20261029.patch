+	}
+	assert.Equal(t, 1, tokenRows)
+	assert.Equal(t, int64(18340), input)
+	assert.Equal(t, int64(6016), cached)
+	assert.Equal(t, int64(156), output)
+	require.Len(t, state.filter(got), len(got))
