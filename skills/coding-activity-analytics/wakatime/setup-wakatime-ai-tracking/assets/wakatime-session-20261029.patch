+func TestCursorStopActivationBoundaryCannotReplayHistoryOrTakePartialTurnUsage(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("WAKATIME_HOME", home)
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	dir := filepath.Join(home, "AppData", "Roaming", "Cursor", "User", "globalStorage")
+	require.NoError(t, os.MkdirAll(dir, 0700))
+	db, err := sql.Open("sqlite", filepath.Join(dir, "state.vscdb"))
+	require.NoError(t, err)
+	_, err = db.Exec(`CREATE TABLE cursorDiskKV(key TEXT PRIMARY KEY,value BLOB)`)
+	require.NoError(t, err)
+	at := time.Now().UTC().Add(-2 * time.Minute)
+	activation := at.Add(3 * time.Second)
+	project := filepath.Join(home, "original-no-git-project")
+	entries := []map[string]any{}
+	for _, item := range []struct {
+		session string
+		seconds [3]int
+	}{{"old", [3]int{0, 1, 2}}, {"straddles", [3]int{2, 4, 5}}, {"new", [3]int{6, 7, 8}}} {
+		entries = append(entries, stopEntry(item.session, "turn-"+item.session))
+		for i, second := range item.seconds {
+			row := map[string]any{"type": 2, "createdAt": at.Add(time.Duration(second) * time.Second).Format(time.RFC3339Nano), "text": "fixture"}
+			if i == 0 {
+				row["type"] = 1
+				row["requestId"] = "turn-" + item.session
+				row["modelInfo"] = map[string]any{"modelName": "grok-4.7"}
+			}
+			if i == 1 {
+				row["toolFormerData"] = map[string]any{"status": "completed", "name": "read_file", "params": fmt.Sprintf(`{"targetFile":%q}`, filepath.Join(project, "main.py"))}
+			}
+			raw, e := json.Marshal(row)
+			require.NoError(t, e)
+			_, e = db.Exec(`INSERT INTO cursorDiskKV VALUES(?,?)`, fmt.Sprintf("bubbleId:%s:%d", item.session, i), string(raw))
+			require.NoError(t, e)
+		}
+	}
+	require.NoError(t, db.Close())
+	// Deliberately start from an old/missing per-session checkpoint.
+	cutoff := at.Add(-time.Hour)
+	state := &parserCheckpoint{Cutoff: cutoff, global: cutoff, Sessions: map[string]*sessionCheckpoint{}}
+	g := Cursor{After: cutoff, CursorStopSince: activation, CursorStopMetadata: stopFixture(t, entries...), ToolIdentity: true, FallbackUserAgent: "cursor/3.24.18", checkpoint: state}
+	hh, err := g.Parse(context.Background())
+	require.NoError(t, err)
+	require.NotEmpty(t, hh)
+	seen := map[string]int{}
+	var input, cached, output int64
+	for _, h := range hh {
+		assert.GreaterOrEqual(t, h.Time, heartbeatTimestamp(activation))
+		assert.NotEqual(t, "old", h.AISession)
+		seen[h.AISession]++
+		if h.AISession == "straddles" {
+			assert.Zero(t, h.AIInputTokens, "do not assign full-turn usage to a partially imported turn")
+			assert.Zero(t, h.AICachedInputTokens)
+			assert.Zero(t, h.AIOutputTokens)
+			if h.EntityType == heartbeat.FileType {
+				assert.Equal(t, filepath.Join(project, "main.py"), h.Entity)
+			} else {
+				assert.Equal(t, project, h.ProjectPathOverride)
+			}
+		}
+		input += h.AIInputTokens
+		cached += h.AICachedInputTokens
+		output += h.AIOutputTokens
+	}
+	assert.Positive(t, seen["straddles"])
+	assert.Positive(t, seen["new"])
+	assert.Equal(t, int64(18340), input)
+	assert.Equal(t, int64(6016), cached)
+	assert.Equal(t, int64(156), output)
+	require.NotEmpty(t, state.filter(hh))
+	again, err := g.Parse(context.Background())
+	require.NoError(t, err)
+	assert.Empty(t, state.filter(again))
+}
