+func TestCursorStopParseBindsRequestAndProjectWithoutNewActivity(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("WAKATIME_HOME", home)
+	t.Setenv("HOME", home)
+	t.Setenv("USERPROFILE", home)
+	dir := filepath.Join(home, "AppData", "Roaming", "Cursor", "User", "globalStorage")
+	require.NoError(t, os.MkdirAll(dir, 0700))
