+
+const codexOpeningFixture = `{"timestamp":"2026-10-29T05:42:56Z","type":"session_meta","payload":{"id":"session-one","cwd":"/project","cli_version":"0.163","source":"vscode"}}
+{"timestamp":"2026-10-29T05:42:56Z","type":"event_msg","payload":{"type":"task_started","turn_id":"turn-one"}}
+{"timestamp":"2026-10-29T05:42:57.344Z","type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"abc"}]}}
+`
+
+const codexOpeningContext = `{"timestamp":"2026-10-29T05:42:57.347Z","type":"turn_context","payload":{"turn_id":"turn-one","cwd":"/project","model":"gpt-6.1-sol","effort":"max"}}
+{"timestamp":"2026-10-29T05:42:58Z","type":"event_msg","payload":{"type":"agent_message","message":"done"}}
+`
+
+func TestCodexOpeningModelWaitsAndSurvivesRepeatedSync(t *testing.T) {
+	home := updateTestHome(t)
+	path := filepath.Join(home, ".codex", "sessions", "opening.jsonl")
+	updateWrite(t, path, codexOpeningFixture)
+	floor := time.Date(2026, 10, 29, 5, 40, 0, 0, time.UTC)
+	checkpoint := &parserCheckpoint{Cutoff: floor, global: floor, Sessions: make(map[string]*sessionCheckpoint)}
+	g := Codex(ParserConfig{ToolIdentity: true, After: floor, checkpoint: checkpoint})
+	hh, err := g.Parse(context.Background())
+	require.NoError(t, err)
+	assert.Empty(t, hh, "a model-less opening prompt stays pending")
+	assert.Empty(t, checkpoint.Sources, "pending source must be reread in full after a later append")
+	assert.Empty(t, checkpoint.filter(hh))
+
+	updateWrite(t, path, codexOpeningFixture+codexOpeningContext)
+	hh, err = g.Parse(context.Background())
+	require.NoError(t, err)
+	require.NotEmpty(t, hh)
+	first := hh[0]
+	assert.InDelta(t, 1793252577.344, first.Time, .000001)
+	assert.Equal(t, 3, first.AIPromptLength)
+	assert.Equal(t, "session-one", first.AISession)
+	assert.Equal(t, "/project", first.ProjectPathOverride)
+	for _, h := range hh {
+		assert.Contains(t, h.UserAgent, "gpt/6.1-sol-max codex/0.163")
+		assert.NotContains(t, h.UserAgent, "unknown/unknown")
+	}
+	require.NotEmpty(t, checkpoint.filter(hh))
+	require.NotEmpty(t, checkpoint.Sources)
+	again, err := g.Parse(context.Background())
+	require.NoError(t, err)
+	assert.Empty(t, checkpoint.filter(again))
+}
+
+func TestCodexOpeningModelsStayWithTheirOwnTurn(t *testing.T) {
+	home := updateTestHome(t)
+	path := filepath.Join(home, ".codex", "sessions", "switch.jsonl")
+	second := `{"timestamp":"2026-10-29T05:43:56Z","type":"event_msg","payload":{"type":"task_started","turn_id":"turn-two"}}
+{"timestamp":"2026-10-29T05:43:57Z","type":"response_item","payload":{"type":"message","role":"user","content":[{"type":"input_text","text":"def"}]}}
+{"timestamp":"2026-10-29T05:43:58Z","type":"turn_context","payload":{"turn_id":"turn-two","model":"opus-5.5","effort":"high","cwd":"/another-project"}}
+{"timestamp":"2026-10-29T05:43:59Z","type":"event_msg","payload":{"type":"agent_message","message":"done"}}
+`
+	updateWrite(t, path, codexOpeningFixture+codexOpeningContext+second)
+	expected, err := (Codex{}).parseTranscript(context.Background(), path)
+	require.NoError(t, err)
+	actual, pending, err := (Codex(ParserConfig{ToolIdentity: true})).parseTranscriptResult(context.Background(), path, 0)
+	require.NoError(t, err)
+	assert.False(t, pending)
+	require.Equal(t, len(expected), len(actual))
+	for i := range actual {
+		if actual[i].AIPromptLength > 0 {
+			if actual[i].Time < 1793252600 {
+				assert.Contains(t, actual[i].UserAgent, "gpt/6.1-sol-max codex/")
+			} else {
+				assert.Contains(t, actual[i].UserAgent, "opus/5.5-high codex/")
+			}
+		}
+		actual[i].UserAgent = expected[i].UserAgent
+		assert.Equal(t, expected[i], actual[i], "timestamps, project, prompt and activity measures are preserved")
+	}
+}
+
+func TestCodexOpeningNeverBorrowsAnotherTurnModel(t *testing.T) {
+	home := updateTestHome(t)
+	path := filepath.Join(home, ".codex", "sessions", "mismatch.jsonl")
+	updateWrite(t, path, codexOpeningFixture+`{"timestamp":"2026-10-29T05:43:56Z","type":"event_msg","payload":{"type":"task_started","turn_id":"different-turn"}}
+{"timestamp":"2026-10-29T05:43:58Z","type":"turn_context","payload":{"turn_id":"different-turn","model":"gpt-6-astra","effort":"high"}}
+{"timestamp":"2026-10-29T05:43:59Z","type":"event_msg","payload":{"type":"agent_message","message":"done"}}
+`)
+	hh, pending, err := (Codex(ParserConfig{ToolIdentity: true})).parseTranscriptResult(context.Background(), path, 0)
+	require.NoError(t, err)
+	assert.True(t, pending)
+	assert.Empty(t, hh, "later turn cannot discharge an unresolved earlier prompt")
+}
