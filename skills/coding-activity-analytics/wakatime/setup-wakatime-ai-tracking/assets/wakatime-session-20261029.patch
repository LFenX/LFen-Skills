+	require.NoError(t, err)
+	_, err = db.Exec(`CREATE TABLE cursorDiskKV(key TEXT PRIMARY KEY,value BLOB)`)
+	require.NoError(t, err)
+	at := time.Now().UTC().Add(-time.Minute)
+	project := filepath.Join(home, "original-local-project")
+	other := filepath.Join(home, "other-local-project")
+	file := filepath.Join(project, "main.py")
+	add := func(session, id string, typ int, second int, request, path string) {
+		row := map[string]any{"type": typ, "createdAt": at.Add(time.Duration(second) * time.Second).Format(time.RFC3339Nano), "text": "fixture", "tokenCount": map[string]any{"inputTokens": 0, "outputTokens": 0}}
+		if typ == 1 {
+			row["requestId"] = request
+			row["modelInfo"] = map[string]any{"modelName": "grok-4.7"}
+		}
+		if path != "" {
+			row["toolFormerData"] = map[string]any{"status": "completed", "name": "read_file", "params": fmt.Sprintf(`{"targetFile":%q}`, path)}
+		}
+		raw, e := json.Marshal(row)
+		require.NoError(t, e)
+		_, e = db.Exec(`INSERT INTO cursorDiskKV VALUES(?,?)`, "bubbleId:"+session+":"+id, string(raw))
+		require.NoError(t, e)
+	}
+	add("session", "user", 1, 0, "turn", "")
+	add("other", "user", 1, 1, "other", "")
+	add("session", "file", 2, 2, "", file)
+	add("other", "file", 2, 3, "", filepath.Join(other, "other.go"))
+	add("session", "answer", 2, 4, "", "")
+	// Another user message with no request identity must reset the binding.
+	add("session", "missing", 1, 5, "", "")
+	add("session", "unassociated", 2, 6, "", "")
+	require.NoError(t, db.Close())
+	cutoff := at.Add(-time.Second)
+	baseline, err := (Cursor{After: cutoff, ToolIdentity: true, FallbackUserAgent: "cursor/3.24.18"}).Parse(context.Background())
+	require.NoError(t, err)
+	state := &parserCheckpoint{global: cutoff, Sessions: map[string]*sessionCheckpoint{}}
+	otherEntry := stopEntry("other", "other")
+	otherEntry["raw_token_counts"] = map[string]any{"input_tokens": 0, "output_tokens": 0, "cache_read_tokens": 0, "cache_write_tokens": 0}
+	g := Cursor{After: cutoff, ToolIdentity: true, FallbackUserAgent: "cursor/3.24.18", CursorStopMetadata: stopFixture(t, stopEntry("session", "turn"), otherEntry), checkpoint: state}
+	got, err := g.Parse(context.Background())
+	require.NoError(t, err)
+	require.Len(t, got, len(baseline))
+	var input, cached, output int64
+	tokenRows := 0
+	for i, h := range got {
+		input += h.AIInputTokens
+		cached += h.AICachedInputTokens
+		output += h.AIOutputTokens
+		if h.AIInputTokens > 0 {
+			tokenRows++
+			assert.Equal(t, "session", h.AISession)
+			assert.Equal(t, project, h.ProjectPathOverride)
+			assert.Equal(t, heartbeatTimestamp(at.Add(4*time.Second)), h.Time)
+		}
+		h.UserAgent = baseline[i].UserAgent
+		h.AIInputTokens = 0
+		h.AICachedInputTokens = 0
+		h.AIOutputTokens = 0
