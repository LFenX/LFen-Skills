+		require.NoError(t, err)
+		_, err = db.Exec(`INSERT INTO events VALUES(?,?,?)`, i, i, string(raw))
+		require.NoError(t, err)
+	}
+	require.NoError(t, db.Close())
+	return path
+}
+func stopEntry(conversation, generation string) map[string]any {
