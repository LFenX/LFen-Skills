diff --git a/pkg/ai/cursor_stop.go b/pkg/ai/cursor_stop.go
new file mode 100644
index 0000000..216caaa
--- /dev/null
+++ b/pkg/ai/cursor_stop.go
@@ -0,0 +1,297 @@
+//go:build (!freebsd && !openbsd && !netbsd && !dragonfly) || (freebsd && (amd64 || arm64)) || (openbsd && (amd64 || arm64))
+
+package ai
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/wakatime/wakatime-cli/pkg/heartbeat"
+	"github.com/wakatime/wakatime-cli/pkg/log"
+)
+
+type cursorStopBinding struct {
+	indices      []int
+	nativeTokens bool
+	startedAt    time.Time
+}
+
+func (g Cursor) stopBindingEligible(b *cursorStopBinding) bool {
+	return g.CursorStopSince.IsZero() || (!b.startedAt.IsZero() && !b.startedAt.Before(g.CursorStopSince))
+}
+
+type cursorStopRecord struct {
+	Conversation string            `json:"conversation_hash"`
+	Generation   string            `json:"generation_hash"`
+	Model        string            `json:"model"`
+	Client       string            `json:"client_version"`
+	Tool         string            `json:"tool"`
+	RecordedAt   time.Time         `json:"recorded_at"`
+	Tokens       map[string]*int64 `json:"raw_token_counts"`
+	conflict     bool
+}
+
+func cursorOpaque(value string) string {
+	if value == "" {
+		return ""
+	}
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(value)))
+}
+func cursorStopKey(conversation, generation string) string {
+	if conversation == "" || generation == "" {
+		return ""
+	}
+	return conversation + ":" + generation
+}
+
+func cursorCheckpointConfig(config ParserConfig) ParserConfig {
+	state := config.checkpoint
+	if state != nil && !state.Cutoff.IsZero() && state.Cutoff.Before(state.global) {
+		// Another tool's activity must not skip a new Cursor conversation.
+		// This parser's own persisted cutoff is its discovery watermark.
+		state.global = state.Cutoff
+		config.After = state.discoveryAfter()
+	}
+	return config
+}
+
+// The metadata journal is a read-only side input. It cannot create activity,
+// change a project, move a timestamp, or replay an already uploaded generation.
+func readCursorStops(ctx context.Context, path string) (map[string]cursorStopRecord, error) {
+	db, err := openAISQLiteDB(ctx, path)
+	if err != nil {
+		return nil, err
+	}
+	defer db.Close()
+	if _, err := db.ExecContext(ctx, "PRAGMA query_only=ON"); err != nil {
+		return nil, err
+	}
+	rows, err := db.QueryContext(ctx, `SELECT metadata FROM (SELECT rowid, metadata, recorded_at FROM events ORDER BY rowid DESC LIMIT 10000) ORDER BY recorded_at, rowid`)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	result := make(map[string]cursorStopRecord)
+	for rows.Next() {
+		var raw string
+		if err := rows.Scan(&raw); err != nil {
+			return nil, err
+		}
+		if len(raw) > 64*1024 {
+			continue
+		}
+		var r cursorStopRecord
+		if json.Unmarshal([]byte(raw), &r) != nil || r.Tool != "Cursor" {
+			continue
+		}
+		key := cursorStopKey(r.Conversation, r.Generation)
+		if key == "" {
+			continue
+		}
+		previous, exists := result[key]
+		if !exists {
+			result[key] = r
+			continue
+		}
+		if previous.Model != "" && r.Model != "" && previous.Model != r.Model {
+			previous.conflict = true
+		}
+		if previous.Client != "" && r.Client != "" && previous.Client != r.Client {
+			previous.conflict = true
+		}
+		if previous.Model == "" {
+			previous.Model = r.Model
+		}
+		if previous.Client == "" {
+			previous.Client = r.Client
+		}
+		if r.RecordedAt.After(previous.RecordedAt) {
+			previous.RecordedAt = r.RecordedAt
+		}
+		if previous.Tokens == nil {
+			previous.Tokens = make(map[string]*int64)
+		}
+		for k, v := range r.Tokens {
+			if v != nil {
+				previous.Tokens[k] = v
+			}
+		}
+		result[key] = previous
+	}
+	return result, rows.Err()
+}
+
+// Only this client/model/cache-write shape was reconciled against same-account
+// official billing. Other shapes retain raw values locally until calibrated.
+func (r cursorStopRecord) calibratedTokens() (int64, int64, int64, bool) {
+	if r.conflict || r.Client != "3.24.18" || (r.Model != "grok-4.7-xhigh" && r.Model != "cursor-grok-4.6-xhigh-fast") {
+		return 0, 0, 0, false
+	}
+	for _, k := range []string{"input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"} {
+		if r.Tokens[k] == nil || *r.Tokens[k] < 0 || *r.Tokens[k] >= 1e15 {
+			return 0, 0, 0, false
+		}
+	}
+	input, cached, write, output := *r.Tokens["input_tokens"], *r.Tokens["cache_read_tokens"], *r.Tokens["cache_write_tokens"], *r.Tokens["output_tokens"]
+	if write != 0 || input < cached {
+		return 0, 0, 0, false
+	}
+	return input - cached, cached, output, true
+}
+
+func cursorCanonicalStopModel(model string) string {
+	// The same generation identifies this explicit Cursor routing alias as
+	// grok-4.6 in modelInfo, and official billing retains the full raw alias.
+	if strings.HasPrefix(model, "cursor-grok-") {
+		return strings.TrimPrefix(model, "cursor-")
+	}
+	return model
+}
+
+func (r cursorStopRecord) complete() bool {
+	for _, k := range []string{"input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"} {
+		if r.Tokens[k] == nil {
+			return false
+		}
+	}
+	return true
+}
+
+// Wait for completed usage before advancing this conversation's checkpoint.
+// Keeping original timestamps preserves the project calculation. An inactive
+// generation falls back to native activity after 15 minutes if its hook fails.
+func (g Cursor) finalizeCursorStops(ctx context.Context, hh Heartbeats, bindings map[string]*cursorStopBinding) Heartbeats {
+	records, err := readCursorStops(ctx, g.CursorStopMetadata)
+	if err != nil {
+		log.Extract(ctx).Warnln("Cursor stop metadata unavailable; native activity preserved")
+		return hh
+	}
+	blocked := make(map[string]float64)
+	if g.checkpoint != nil {
+		for key, b := range bindings {
+			if !g.stopBindingEligible(b) {
+				continue
+			}
+			r := records[key]
+			settled := r.complete() && (r.RecordedAt.IsZero() || time.Since(r.RecordedAt) >= 10*time.Second)
+			if b.nativeTokens || settled || len(b.indices) == 0 {
+				continue
+			}
+			first, last := hh[b.indices[0]].Time, hh[b.indices[0]].Time
+			for _, i := range b.indices {
+				first = min(first, hh[i].Time)
+				last = max(last, hh[i].Time)
+			}
+			if time.Since(heartbeatTime(last)) > 15*time.Minute {
+				continue
+			}
+			session := hh[b.indices[0]].AISession
+			if prior, exists := blocked[session]; !exists || first < prior {
+				blocked[session] = first
+			}
+		}
+	}
+	if len(blocked) > 0 {
+		kept := make(Heartbeats, 0, len(hh))
+		mapping := make(map[int]int)
+		for i, h := range hh {
+			if at, exists := blocked[h.AISession]; exists && h.Time >= at {
+				continue
+			}
+			mapping[i] = len(kept)
+			kept = append(kept, h)
+		}
+		for _, b := range bindings {
+			indices := make([]int, 0, len(b.indices))
+			for _, i := range b.indices {
+				if newIndex, exists := mapping[i]; exists {
+					indices = append(indices, newIndex)
+				}
+			}
+			b.indices = indices
+		}
+		hh = kept
+	}
+	g.enrichCursorStopsWithRecords(hh, bindings, records)
+	return hh
+}
+
+func (g Cursor) enrichCursorStops(ctx context.Context, hh Heartbeats, bindings map[string]*cursorStopBinding) {
+	records, err := readCursorStops(ctx, g.CursorStopMetadata)
+	if err != nil {
+		log.Extract(ctx).Warnln("Cursor stop metadata unavailable; native activity preserved")
+		return
+	}
+	g.enrichCursorStopsWithRecords(hh, bindings, records)
+}
+
+func (g Cursor) enrichCursorStopsWithRecords(hh Heartbeats, bindings map[string]*cursorStopBinding, records map[string]cursorStopRecord) {
+	for key, binding := range bindings {
+		if !g.stopBindingEligible(binding) {
+			continue
+		}
+		r, ok := records[key]
+		if !ok || r.conflict {
+			continue
+		}
+		// Never replace a different actual model with the selected UI model.
+		compatible := true
+		for _, i := range binding.indices {
+			_, products := splitUserAgent(hh[i].UserAgent)
+			fields := strings.Fields(products)
+			if len(fields) == 0 {
+				continue
+			}
+			if strings.EqualFold(userAgentProduct(fields[0]), "cursor") {
+				continue // A tool-only UA contains no native model to conflict.
+			}
+			actual := cursorCanonicalStopModel(strings.Replace(fields[0], "/", "-", 1))
+			model := cursorCanonicalStopModel(r.Model)
+			if actual != "unknown-unknown" && actual != "unknown-model" && actual != model && !strings.HasPrefix(model, actual+"-") {
+				compatible = false
+				break
+			}
+		}
+		if !compatible {
+			continue
+		}
+		for _, i := range binding.indices {
+			hh[i].UserAgent = aiToolUserAgent("cursor/"+r.Client+" uploader/cursor-stop-metadata@2", cursorModelUserAgentToken(cursorCanonicalStopModel(r.Model)), "Cursor")
+		}
+		input, cached, output, valid := r.calibratedTokens()
+		if !valid || binding.nativeTokens || g.checkpoint == nil || g.checkpoint.CursorStops[key] {
+			continue
+		}
+		// Keep the exact original entity, session, project hint and activity time.
+		// No target means no upload: an unassociated usage row is never guessed.
+		target := -1
+		for _, i := range binding.indices {
+			h := hh[i]
+			previous := g.checkpoint.Sessions[h.AISession]
+			if previous != nil && !heartbeatTime(h.Time).After(previous.Cutoff) {
+				// A late update to an already uploaded heartbeat would otherwise
+				// be moved to observation time by the shared checkpoint filter.
+				// Keep historical project durations untouched instead.
+				continue
+			}
+			if h.ProjectPathOverride != "" || (h.EntityType == heartbeat.FileType && filepath.IsAbs(h.Entity)) {
+				target = i
+			}
+		}
+		if target < 0 {
+			continue
+		}
+		hh[target].AIInputTokens = input
+		hh[target].AICachedInputTokens = cached
+		hh[target].AIOutputTokens = output
+		if g.checkpoint.CursorStops == nil {
+			g.checkpoint.CursorStops = make(map[string]bool)
+		}
+		g.checkpoint.CursorStops[key] = true
+	}
+}
