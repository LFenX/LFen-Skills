+func TestCursorStopWaitsForUsageAndPreservesCheckpoint(t *testing.T) {
+	at := time.Now().UTC().Add(-time.Minute)
+	state := &parserCheckpoint{Cutoff: at.Add(-time.Second), global: at.Add(-time.Second), Sessions: map[string]*sessionCheckpoint{"session": {Cutoff: at.Add(-time.Second)}}}
+	key := cursorStopKey(cursorOpaque("session"), cursorOpaque("turn"))
+	incomplete := stopEntry("session", "turn")
+	incomplete["raw_token_counts"] = map[string]any{}
+	g := Cursor{CursorStopMetadata: stopFixture(t, incomplete), checkpoint: state}
+	input := Heartbeats{stopHeartbeat(at)}
+	assert.Empty(t, g.finalizeCursorStops(context.Background(), input, map[string]*cursorStopBinding{key: {indices: []int{0}}}))
+	assert.Empty(t, state.CursorStops)
+	assert.Equal(t, at.Add(-time.Second), state.Sessions["session"].Cutoff)
+	freshStop := stopEntry("session", "turn")
+	freshStop["recorded_at"] = time.Now().UTC().Format(time.RFC3339Nano)
+	g.CursorStopMetadata = stopFixture(t, freshStop)
+	assert.Empty(t, g.finalizeCursorStops(context.Background(), input, map[string]*cursorStopBinding{key: {indices: []int{0}}}), "complete callbacks settle before checkpoint advancement")
+	// Another parser advances while this generation waits; Cursor discovery
+	// still starts at its own watermark for new conversations as well.
+	state.global = time.Now().UTC()
+	c := cursorCheckpointConfig(ParserConfig{After: state.global, checkpoint: state})
+	assert.True(t, c.After.Before(at))
+	assert.True(t, c.sessionAfter("new-conversation").Before(at))
+	g.CursorStopMetadata = stopFixture(t, incomplete, stopEntry("session", "turn"))
+	ready := g.finalizeCursorStops(context.Background(), input, map[string]*cursorStopBinding{key: {indices: []int{0}}})
+	require.Len(t, ready, 1)
+	assert.Equal(t, input[0].Time, ready[0].Time)
+	assert.Equal(t, input[0].ProjectPathOverride, ready[0].ProjectPathOverride)
+	assert.Equal(t, int64(18340), ready[0].AIInputTokens)
+	require.Len(t, state.filter(ready), 1)
+	assert.Empty(t, state.filter(ready), "completed activity is still exactly once")
+}
