@@ -0,0 +1,72 @@
+package ai
+
+import "strings"
+
+// aiToolUserAgent writes an explicit model/tool pair and keeps the host as
+// metadata. The caller supplies the actual model from its parser; a software
+// version or previous session's model must never become an unknown model.
+func aiToolUserAgent(userAgent, modelToken, tool string) string {
+	header, products := splitUserAgent(userAgent)
+	fields := strings.Fields(products)
+	actor := strings.ToLower(canonicalAgentToken(tool))
+	switch actor {
+	case "claude":
+		actor = "claude-code"
+	case "cursor-agent":
+		actor = "cursor"
+	}
+
+	version := "unknown"
+	for _, token := range fields {
+		product, candidate, found := strings.Cut(token, "/")
+		product = strings.ToLower(product)
+		if found && candidate != "" && !strings.Contains(product, "wakatime") &&
+			(product == actor || strings.HasPrefix(product, actor+"-")) {
+			version = candidate
+			break
+		}
+	}
+
+	actorToken := actor + "/" + version
+	if actor == "grok-bot" && version == "unknown" {
+		actorToken = actor // This source does not expose an application version.
+	}
+	if modelToken == "" || modelToken == "unknown/unknown" || modelToken == "unknown-model" {
+		// Keep the missing model explicit, followed only by the measured tool
+		// name. In the service, codex/<app version> can be consumed as a model.
+		// No app version or trailing provenance product may fill that slot.
+		return strings.TrimSpace(header + " unknown/unknown " + actor)
+	}
+	result := []string{modelToken, actorToken}
+	seen := map[string]bool{strings.ToLower(result[0]): true, strings.ToLower(result[1]): true}
+	for _, token := range fields {
+		if strings.EqualFold(token, modelToken) {
+			continue
+		}
+		if strings.EqualFold(token, result[1]) {
+			if _, host := knownIDEFieldIndex([]string{token}); !host {
+				continue
+			}
+		}
+		product := strings.ToLower(userAgentProduct(token))
+		// A prefix such as source-codex-cli/ still matches WakaTime's editor
+		// detector. Keep provenance in a value, never as a second product token.
+		if strings.HasPrefix(token, "host/") || strings.HasPrefix(token, "source/") || strings.HasPrefix(token, "uploader/") {
+			// Already normalized; retain it without accumulating wrappers.
+		} else {
+			kind := "source"
+			if _, known := knownIDEFieldIndex([]string{token}); known || strings.HasPrefix(product, "host-") {
+				kind = "host"
+			} else if strings.Contains(product, "wakatime") {
+				kind = "uploader"
+			}
+			token = kind + "/" + strings.ReplaceAll(strings.TrimPrefix(strings.TrimPrefix(token, "host-"), "source-"), "/", "@")
+		}
+		key := strings.ToLower(token)
+		if !seen[key] {
+			result = append(result, token)
+			seen[key] = true
+		}
+	}
+	return strings.TrimSpace(header + " " + strings.Join(result, " "))
+}
diff --git a/pkg/ai/activity_identity_internal_test.go b/pkg/ai/activity_identity_internal_test.go
new file mode 100644
index 0000000..df6527c
--- /dev/null
+++ b/pkg/ai/activity_identity_internal_test.go
@@ -0,0 +1,96 @@
+//go:build (!freebsd && !openbsd && !netbsd && !dragonfly) || (freebsd && (amd64 || arm64)) || (openbsd && (amd64 || arm64))
+
+package ai
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"github.com/wakatime/wakatime-cli/pkg/heartbeat"
+)
+
+func TestToolIdentitySeparatesCodexFromCursor(t *testing.T) {
+	config := ParserConfig{ToolIdentity: true}
+	codex := Codex(config)
+	got := codex.userAgent("/project/main.go", "gpt-6.1-sol-max", "0.163", "vscode",
+		map[string]string{"/project/main.go": "cursor/1.128 vscode-wakatime/30.2"}, "codex-cli/0.154")
+	assert.Equal(t, "gpt/6.1-sol-max codex/0.163 host/cursor@1.128 source/codex-vscode@0.163 uploader/vscode-wakatime@30.2", got)
+	assert.Equal(t, got, aiToolUserAgent(got, "gpt/6.1-sol-max", "Codex"))
+}
+
+func TestToolIdentityUnknownModelIsNotSoftwareVersion(t *testing.T) {
+	codex := Codex(ParserConfig{ToolIdentity: true})
+	got := codex.userAgent("/project/main.go", "", "0.163", "vscode", nil, "codex-cli/0.154 plugin-wakatime/1")
+	assert.Equal(t, "unknown/unknown codex", got)
+	assert.NotContains(t, got, "gpt/")
+	assert.Equal(t, "unknown/unknown grok-bot",
+		aiToolUserAgent("grok-bot codex-cli/0.154 codex-cli-wakatime/1", "", "Grok Bot"))
+	assert.Equal(t, "unknown/unknown grok-bot",
+		aiToolUserAgent("grok-bot/0.77.0 codex-cli/0.154 codex-cli-wakatime/1", "", "Grok Bot"))
+	assert.Equal(t, "wakatime/v2.28.0 (Windows NT-10.0-amd64) go1.27.3 unknown/unknown codex",
+		aiToolUserAgent("wakatime/v2.28.0 (Windows NT-10.0-amd64) go1.27.3 codex/0.163 source/codex-cli@0.154", "unknown-model", "Codex"))
+}
+
+func TestToolIdentityKeepsModelVersionAndReasoningEffort(t *testing.T) {
+	for _, model := range []string{"gpt/6.1-sol-max", "gpt/6-astra-xhigh", "opus/5.5", "deepseek/4-pro", "composer/2.5"} {
+		got := aiToolUserAgent(model+" cursor/1.128 codex-vscode/0.163 vscode-wakatime/30.2", model, "Codex")
+		assert.Contains(t, got, model+" codex/0.163 ")
+	}
+}
+
+func TestToolIdentityRetainsHeaderAndOtherClients(t *testing.T) {
+	got := aiToolUserAgent("wakatime/v2.28.0 (Windows NT-10.0-amd64) go1.27.3 opus/5.5 cursor/1.128 claude-code/2.0 vscode-wakatime/30.2", "opus/5.5", "Claude")
+	assert.Contains(t, got, "wakatime/v2.28.0 (Windows NT-10.0-amd64) go1.27.3 opus/5.5 claude-code/2.0 host/cursor@1.128")
+	opencode := newCheckpointOpenCode(ParserConfig{ToolIdentity: true, FallbackUserAgent: "cursor/1.128 vscode-wakatime/30.2"})
+	assert.Contains(t, opencode.userAgent("/project/main.py", "deepseek-4-pro", "1.2"), "deepseek/4-pro opencode/1.2 host/cursor@1.128")
+	cursor := Cursor(ParserConfig{ToolIdentity: true, FallbackUserAgent: "cursor/1.128 vscode-wakatime/30.2"})
+	assert.Contains(t, cursor.userAgent("/project/main.ts", "composer-2.5"), "composer/2.5 cursor/1.128 host/cursor@1.128")
+}
+
+func TestToolIdentityDoesNotChangeActivityMeasurements(t *testing.T) {
+	lineChanges := 5
+	event := genericAIEvent{sessionID: "isolated-fixture", timestamp: time.Unix(1793100000, 0),
+		filePath: "/project/main.go", cwd: "/project", model: "gpt-6.1-sol-max", input: 300, cachedInput: 200, output: 50,
+		tokensFound: true, lineChanges: &lineChanges}
+	baseline := ParserConfig{FallbackUserAgent: "cursor/1.128 vscode-wakatime/30.2"}
+	expected := genericAIEventHeartbeats(Codex(baseline), baseline, event)
+	baseline.ToolIdentity = true
+	actual := genericAIEventHeartbeats(Codex(baseline), baseline, event)
+	require.Equal(t, len(expected), len(actual))
+	for i := range expected {
+		assert.NotEqual(t, expected[i].UserAgent, actual[i].UserAgent)
+		actual[i].UserAgent = expected[i].UserAgent
+		assert.Equal(t, expected[i], actual[i], "only source identity may change")
+	}
+}
+
+func TestStrictPatchPathsKeepsUnresolvedExpressionAsActivity(t *testing.T) {
+	g := Codex(ParserConfig{ToolIdentity: true, StrictPatchPaths: true})
+	stamp := time.Unix(1793100000, 0)
+	for _, expression := range []string{`"+path+"`, `" + name + "`, `' + filename + '`} {
+		input := "*** Begin Patch\n*** Add File: " + expression + "\n+print('fixture')\n*** End Patch"
+		rows := g.patchHeartbeats(stamp, "0.163", "gpt-6.1-sol-max", "vscode", "/project", nil,
+			"codex-cli/0.154", input, "fixture-session", heartbeat.AITokens{CurrentInput: 100})
+		require.Len(t, rows, 1)
+		assert.Equal(t, heartbeat.AppType, rows[0].EntityType)
+		assert.Equal(t, "Codex fixture-session", rows[0].Entity)
+		assert.Equal(t, "/project", rows[0].ProjectPathOverride)
+		assert.Nil(t, rows[0].AILineChanges)
+		assert.Nil(t, rows[0].Language)
+		assert.Equal(t, int64(100), rows[0].AIInputTokens)
+	}
+}
+
+func TestStrictPatchPathsPreservesLiteralPaths(t *testing.T) {
+	for _, name := range []string{"main.py", "A+B file.py", "literal$path.py"} {
+		g := Codex(ParserConfig{StrictPatchPaths: true})
+		rows := g.patchHeartbeats(time.Unix(1793100000, 0), "0.163", "gpt-6.1-sol-max", "vscode", "/project", nil,
+			"codex-cli/0.154", "*** Begin Patch\n*** Add File: "+name+"\n+print('fixture')\n*** End Patch", "fixture-session", heartbeat.AITokens{})
+		require.Len(t, rows, 1)
+		assert.Equal(t, heartbeat.FileType, rows[0].EntityType)
+		require.NotNil(t, rows[0].AILineChanges)
+		assert.Equal(t, 1, *rows[0].AILineChanges)
+	}
+}
