+func TestCursorStopExactJoinPreservesMeasurementsAndDeduplicates(t *testing.T) {
+	path := stopFixture(t, stopEntry("session", "turn"), stopEntry("session", "turn"))
+	at := time.Date(2026, 10, 29, 4, 0, 0, 0, time.UTC)
+	state := &parserCheckpoint{Sessions: map[string]*sessionCheckpoint{"session": {Cutoff: at.Add(-time.Second)}}}
+	g := Cursor{ToolIdentity: true, CursorStopMetadata: path, checkpoint: state}
+	hh := Heartbeats{stopHeartbeat(at), stopHeartbeat(at.Add(time.Second))}
+	before := append(Heartbeats{}, hh...)
+	key := cursorStopKey(cursorOpaque("session"), cursorOpaque("turn"))
+	bindings := map[string]*cursorStopBinding{key: {indices: []int{0, 1}}}
+	g.enrichCursorStops(context.Background(), hh, bindings)
+	assert.Zero(t, hh[0].AIInputTokens)
+	assert.Equal(t, int64(18340), hh[1].AIInputTokens)
+	assert.Equal(t, int64(6016), hh[1].AICachedInputTokens)
+	assert.Equal(t, int64(156), hh[1].AIOutputTokens)
+	for i, h := range hh {
+		assert.Contains(t, h.UserAgent, "grok/4.7-xhigh cursor/3.24.18")
+		h.UserAgent = before[i].UserAgent
+		h.AIInputTokens = 0
+		h.AICachedInputTokens = 0
+		h.AIOutputTokens = 0
+		assert.Equal(t, before[i], h, "project/session/entity/time/line/prompt fields remain exactly equal")
+	}
+	// Simulate persisting state and restarting the process.
+	raw, err := json.Marshal(state)
+	require.NoError(t, err)
+	var restored parserCheckpoint
+	require.NoError(t, json.Unmarshal(raw, &restored))
+	g.checkpoint = &restored
+	again := Heartbeats{stopHeartbeat(at.Add(2 * time.Second))}
+	g.enrichCursorStops(context.Background(), again, map[string]*cursorStopBinding{key: {indices: []int{0}}})
+	assert.Zero(t, again[0].AIInputTokens)
+	assert.Zero(t, again[0].AIOutputTokens)
