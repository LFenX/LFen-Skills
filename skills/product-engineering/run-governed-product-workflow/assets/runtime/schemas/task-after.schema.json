{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lfen.local/schemas/v6.3/task-after.schema.json",
  "title": "V6.3 TaskOutcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta_type",
    "project_id",
    "work_item_id",
    "task_id",
    "revision",
    "status",
    "completed_at",
    "source_snapshot",
    "established_facts",
    "actual_changes",
    "verification",
    "incomplete_items",
    "legacy_issues",
    "decisions",
    "evidence_refs",
    "next_tasks",
    "artifact_manifest",
    "amendments"
  ],
  "properties": {
    "schema_version": {
      "const": "6.3-candidate"
    },
    "proof_contract_version": {
      "const": "implemented-proof-v1"
    },
    "meta_type": {
      "const": "TaskOutcome"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "work_item_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "changed_count",
        "out_of_scope",
        "undeclared_untouched",
        "baseline_sha256",
        "scope_sha256",
        "delivery_sha256",
        "report_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "Passed",
            "Skipped"
          ]
        },
        "changed_count": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "undeclared_untouched": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_declarations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "baseline_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "delivery_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "Implemented",
        "Deferred",
        "Cancelled",
        "Blocked",
        "Superseded"
      ]
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_snapshot": {
      "type": "object",
      "minProperties": 1
    },
    "established_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actual_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "result",
          "evidence_refs"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "Passed",
              "Failed",
              "Blocked",
              "Skipped",
              "Not Applicable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "method": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "incomplete_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "reason",
          "impact",
          "owner",
          "reentry_condition"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reentry_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "legacy_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "reason",
          "impact",
          "owner",
          "reentry_condition"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reentry_condition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "relation",
          "reason"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "observed-from",
              "affected-by",
              "addresses",
              "extends",
              "refines"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact_manifest": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meta_type",
          "legacy_kind",
          "action",
          "asset_id",
          "content_ref",
          "reason",
          "rule_reference",
          "owner",
          "source_snapshot",
          "human_confirmation_refs",
          "outcome"
        ],
        "properties": {
          "meta_type": {
            "enum": [
              "ProjectState",
              "TaskContract",
              "RunLedger",
              "TaskOutcome",
              "AuthorityAsset",
              "DerivedView"
            ]
          },
          "legacy_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "enum": [
              "Create/Revise",
              "Reference",
              "Generate",
              "On Event",
              "N/A"
            ]
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "content_ref": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "rule_reference": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source_snapshot": {
            "type": "string",
            "minLength": 1
          },
          "human_confirmation_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome": {
            "enum": [
              "Created",
              "Revised",
              "Referenced",
              "Generated",
              "Not Triggered",
              "Not Applicable",
              "Deferred"
            ]
          }
        }
      }
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_revision",
          "to_revision",
          "path",
          "old_value",
          "new_value",
          "reason",
          "basis",
          "changed_at"
        ]
      }
    },
    "user_decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "const": "Pending"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presented",
            "response",
            "decided_by",
            "evidence_ref",
            "outcome",
            "decided_at",
            "subject_sha256"
          ],
          "properties": {
            "presented": {
              "type": "string",
              "minLength": 1
            },
            "response": {
              "type": "string",
              "minLength": 1
            },
            "decided_by": {
              "type": "string",
              "minLength": 1
            },
            "evidence_ref": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "enum": [
                "Approved",
                "Rejected",
                "Deferred"
              ]
            },
            "decided_at": {
              "type": "string",
              "format": "date-time"
            },
            "subject_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "adversarial_review": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "recorded_at",
              "prompt",
              "evidence_ref"
            ],
            "properties": {
              "event": {
                "const": "Offer"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "recorded_at",
              "outcome",
              "response",
              "decided_by",
              "evidence_ref"
            ],
            "properties": {
              "event": {
                "const": "Decision"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "outcome": {
                "enum": [
                  "Accepted",
                  "Declined",
                  "Deferred",
                  "Stopped"
                ]
              },
              "response": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "decided_by": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "recorded_at",
              "reason",
              "evidence_refs"
            ],
            "properties": {
              "event": {
                "const": "Blocked"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event",
              "recorded_at",
              "round_id",
              "started_at",
              "reviewer",
              "delivery_task_id",
              "subject_sha256",
              "requirements_sha256",
              "coverage",
              "unreviewed_items",
              "evidence_refs",
              "findings",
              "resolutions"
            ],
            "properties": {
              "event": {
                "const": "Round"
              },
              "recorded_at": {
                "type": "string",
                "format": "date-time"
              },
              "round_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "started_at": {
                "type": "string",
                "format": "date-time"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "delivery_task_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "subject_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "requirements_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "coverage": {
                "enum": [
                  "Complete",
                  "Incomplete"
                ]
              },
              "review_contract_version": {
                "const": "report-bound-v2"
              },
              "report_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "report_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "delivery_completed_at": {
                "type": "string",
                "format": "date-time"
              },
              "delivery_verified_at": {
                "type": "string",
                "format": "date-time"
              },
              "session_completed": {
                "type": "boolean"
              },
              "unreviewed_items": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "summary",
                    "evidence_refs"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "evidence_refs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              },
              "resolutions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "finding_id",
                    "disposition",
                    "reason",
                    "evidence_refs"
                  ],
                  "properties": {
                    "finding_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "disposition": {
                      "enum": [
                        "Fixed",
                        "NotAnIssue"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "evidence_refs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "adversarial_review_parent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
