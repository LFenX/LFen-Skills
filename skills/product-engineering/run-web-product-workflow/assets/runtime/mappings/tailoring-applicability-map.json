    {"order": 2, "rule": "Critical over High over Medium over Low control strength"},
    {"order": 3, "rule": "active extension and explicit applicability fact over generic route"},
    {"order": 4, "rule": "change surface and all development types are unioned; primary type is display-only"},
    {"order": 5, "rule": "delivery scenario, baseline inheritance, mode, and stage add controls but do not subtract"},
    {"order": 6, "rule": "specific owner-standard profile rule over generic profile rule"},
    {"order": 7, "rule": "when equal-rank rules conflict, keep both, mark conflict, and stop the affected action"}
  ],
  "mandatory_reclassification_triggers": [
    "scope, acceptance, authority, risk, development type, surface, extension state, baseline or mode changes",
    "new evidence changes any applicability fact",
    "a stable reference becomes stale, conflicted, superseded or unavailable",
    "an external effect, irreversible action, production release or human gate is newly discovered",
    "the task enters a stage whose exit gate requires previously unresolved facts"
  ],
  "resolution_contract": {
    "required_inputs": ["task_profile", "applicability_facts", "extension_evidence_refs", "scope", "authority", "acceptance", "source_snapshot", "stage"],
    "required_outputs": ["rule_set_sha256", "normative_sources_sha256", "resolver_sha256", "task_contract_schema_sha256", "input_digest", "applicable_standards", "pending_standards", "stage_context_standards", "control_strength", "independent_review", "blocking_reasons", "rule_ids", "source_sections", "complete_source_files", "profile_coverage_digest"],
    "freshness": "resolution is stale after any mandatory reclassification trigger or source snapshot change",
    "execution_gate": "S4 and later require zero blocking reasons for the affected action",
    "closure_gate": "S8 preserves unresolved facts and successor TaskIDs; it never converts Unknown to No"
  }
}
