{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lfen.local/schemas/v6.3/authority-asset.schema.json",
  "title": "V6.3 AuthorityAsset Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta_type", "project_id", "asset_id", "legacy_kind", "profile_state_model", "title", "owner", "state", "revision", "source", "scope", "trace_links", "native_format", "content_ref", "access_classification", "retention_rule", "history_ref", "profile_fields"],
  "properties": {
    "schema_version": {"const": "6.3-candidate"},
    "meta_type": {"const": "AuthorityAsset"},
    "project_id": {"type": "string", "minLength": 1},
    "asset_id": {"type": "string", "minLength": 1},
    "legacy_kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{2}$"},
    "profile_state_model": {"enum": ["DOC", "CASE", "EXEC", "EVID", "DEC", "REC"]},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "source": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "trace_links": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["relation", "target"],
        "properties": {"relation": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}
      }
    },
    "native_format": {"type": "string", "minLength": 1},
    "content_ref": {"type": "string", "minLength": 1},
    "access_classification": {"type": "string", "minLength": 1},
    "retention_rule": {"type": "string", "minLength": 1},
    "history_ref": {"type": "string", "minLength": 1},
    "profile_fields": {"type": "object", "minProperties": 1}
  }
}
