{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lfen.local/schemas/v6.3/derived-view.schema.json",
  "title": "V6.3 DerivedView",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "meta_type", "project_id", "view_id", "view_kind", "generated_at", "generator", "source_snapshot", "sources", "content_ref", "integrity_status"],
  "properties": {
    "schema_version": {"const": "6.3-candidate"},
    "meta_type": {"const": "DerivedView"},
    "project_id": {"type": "string", "minLength": 1},
    "view_id": {"type": "string", "minLength": 1},
    "view_kind": {"type": "string", "minLength": 1},
    "legacy_kind": {"type": ["string", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "string", "minLength": 1},
    "source_snapshot": {"type": "string", "minLength": 1},
    "source_snapshot_method": {"enum": ["raw-source-bytes-v1", "retrieval-contract-projection-v1"]},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "content_ref": {"type": "string", "minLength": 1},
    "integrity_status": {"enum": ["Complete", "Incomplete", "Stale", "Failed"]}
  }
}
