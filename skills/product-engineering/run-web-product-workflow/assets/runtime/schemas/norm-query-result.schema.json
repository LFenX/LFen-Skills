{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lfen.local/schemas/v6.3/norm-query-result.schema.json",
  "title": "V6.3 Candidate Norm Query Result",
  "x-lfen-semantic-invariants": [
    "coverage.present and coverage.missing are disjoint and their union equals coverage.required",
    "status Complete requires coverage.missing to be empty",
    "line_end is greater than or equal to line_start for every citation",
    "used_chars, sources_used, and escalations_used do not exceed their requested limits",
    "citation chunk_sha256 is recomputed from text and retrieval_locator is recomputed from source prefix, heading-path hash, ordinal, and chunk prefix",
    "fallback page does not exceed page_count"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta_type",
    "status",
    "query_digest",
    "index_digest",
    "consistency_report_sha256",
    "tailoring_resolution_sha256",
    "normative_sources_sha256",
    "coverage",
    "budget",
    "citations",
    "fallback",
    "blocker_reasons",
    "event_ref"
  ],
  "properties": {
    "schema_version": {"const": "6.3-candidate"},
    "meta_type": {"const": "DerivedView"},
    "status": {"enum": ["Complete", "Expanded", "Blocked"]},
    "query_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "index_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "consistency_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tailoring_resolution_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normative_sources_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "present", "missing"],
      "properties": {
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "present": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "candidate_limit",
        "requested_chars",
        "used_chars",
        "source_limit",
        "sources_used",
        "escalation_limit",
        "escalations_used",
        "omitted_count",
        "overflow_reason"
      ],
      "properties": {
        "profile": {"enum": ["compact", "standard", "extended", "source-required"]},
        "candidate_limit": {"type": "integer", "minimum": 1},
        "requested_chars": {"type": "integer", "minimum": 1},
        "used_chars": {"type": "integer", "minimum": 0},
        "source_limit": {"type": "integer", "minimum": 1},
        "sources_used": {"type": "integer", "minimum": 0},
        "escalation_limit": {"type": "integer", "minimum": 0},
        "escalations_used": {"type": "integer", "minimum": 0},
        "omitted_count": {"type": "integer", "minimum": 0},
        "overflow_reason": {"type": ["string", "null"]}
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "retrieval_locator",
          "locator_kind",
          "source_id",
          "source_version",
          "logical_path",
          "source_sha256",
          "heading_path",
          "line_start",
          "line_end",
          "chunk_sha256",
          "retrieval_reason",
          "lane_ranks",
          "priority",
          "control_types",
          "text"
        ],
        "properties": {
          "retrieval_locator": {"type": "string", "minLength": 1},
          "locator_kind": {"const": "derived-retrieval-locator"},
          "source_id": {"type": "string", "minLength": 1},
          "source_version": {"type": "string", "minLength": 1},
          "logical_path": {"type": "string", "pattern": "^references/"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1},
          "chunk_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "retrieval_reason": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "lane_ranks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pinned", "exact", "fts_word", "fts_trigram", "semantic"],
            "properties": {
              "pinned": {"type": ["integer", "null"], "minimum": 1},
              "exact": {"type": ["integer", "null"], "minimum": 1},
              "fts_word": {"type": ["integer", "null"], "minimum": 1},
              "fts_trigram": {"type": ["integer", "null"], "minimum": 1},
              "semantic": {"type": ["integer", "null"], "minimum": 1}
            }
          },
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "control_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_id", "heading_path", "page", "page_count", "reason"],
      "properties": {
        "kind": {"enum": ["none", "section", "source", "paged-source"]},
        "source_id": {"type": ["string", "null"]},
        "heading_path": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "page_count": {"type": ["integer", "null"], "minimum": 1},
        "reason": {"type": ["string", "null"]}
      }
    },
    "blocker_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "event_ref": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "Complete"}}, "required": ["status"]},
      "then": {
        "properties": {
          "fallback": {"properties": {"kind": {"const": "none"}}},
          "coverage": {"properties": {"missing": {"maxItems": 0}}},
          "blocker_reasons": {"maxItems": 0},
          "event_ref": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "Expanded"}}, "required": ["status"]},
      "then": {
        "properties": {
          "fallback": {"properties": {"kind": {"enum": ["section", "source", "paged-source"]}}},
          "event_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "Blocked"}}, "required": ["status"]},
      "then": {
        "properties": {
          "blocker_reasons": {"minItems": 1},
          "event_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"fallback": {"properties": {"kind": {"const": "none"}}}}},
      "then": {
        "properties": {
          "fallback": {
            "properties": {
              "source_id": {"type": "null"},
              "heading_path": {"maxItems": 0},
              "page": {"type": "null"},
              "page_count": {"type": "null"},
              "reason": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"fallback": {"properties": {"kind": {"const": "section"}}}}},
      "then": {
        "properties": {
          "fallback": {
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "heading_path": {"minItems": 1},
              "page": {"type": "null"},
              "page_count": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"fallback": {"properties": {"kind": {"const": "source"}}}}},
      "then": {
        "properties": {
          "fallback": {
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "page": {"type": "null"},
              "page_count": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"fallback": {"properties": {"kind": {"const": "paged-source"}}}}},
      "then": {
        "properties": {
          "fallback": {
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "page": {"type": "integer", "minimum": 1},
              "page_count": {"type": "integer", "minimum": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  ]
}
